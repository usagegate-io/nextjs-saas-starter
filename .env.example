# Supabase → Project Settings → API (or let the Vercel Supabase integration set these).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# UsageGate → Dashboard → API keys. Server-side only.
USAGEGATE_KEY=gk_live_...

# Your own Stripe account (the one your customers pay).
STRIPE_SECRET_KEY=sk_test_...
# The Price id of your paid plan. Paste the same id on that plan in UsageGate → Access rules.
STRIPE_PRICE_PRO=price_...
